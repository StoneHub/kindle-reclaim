# Copy to /mnt/us/billboard/config.env and adjust as needed.

: "${BILLBOARD_URL:=http://192.168.50.131:8765/current.png}"
: "${PLAYLIST_URL:=http://192.168.50.131:8765/playlist.txt}"
: "${DAYLIGHT_URL:=http://192.168.50.131:8765/daylight.env}"
: "${CHARGING_INTERVAL_SECONDS:=3600}"
: "${BATTERY_INTERVAL_SECONDS:=43200}"
: "${DAY_START_HOUR:=7}"
: "${DAY_START_MINUTE:=0}"
: "${DAY_END_HOUR:=21}"
: "${DAY_END_MINUTE:=0}"
: "${USE_SUSPEND:=1}"
: "${FETCH_TIMEOUT_SECONDS:=30}"
: "${FETCH_RETRIES:=2}"
: "${RENDER_ON_CHANGE:=1}"

: "${STATE_DIR:=/mnt/us/billboard/state}"
: "${LOG_DIR:=/mnt/us/billboard/logs}"
: "${STOP_FLAG:=$STATE_DIR/stop.flag}"
: "${PID_FILE:=$STATE_DIR/poller.pid}"
: "${LOCK_DIR:=$STATE_DIR/poller.lock}"
: "${LOG_FILE:=$LOG_DIR/poller.log}"
: "${LAST_RESULT_FILE:=$STATE_DIR/last_result}"
: "${LAST_SUCCESS_FILE:=$STATE_DIR/last_success}"
: "${DAYLIGHT_CACHE_FILE:=$STATE_DIR/daylight.env}"
: "${PLAYLIST_CACHE_DIR:=$STATE_DIR/playlist-cache}"
: "${PLAYLIST_ENTRIES_FILE:=$STATE_DIR/playlist.entries}"
: "${PLAYLIST_INDEX_FILE:=$STATE_DIR/playlist.index}"
: "${PLAYLIST_COUNT_FILE:=$STATE_DIR/playlist.count}"
: "${PLAYLIST_AUTOROTATE_FILE:=$STATE_DIR/playlist.autorotate}"
